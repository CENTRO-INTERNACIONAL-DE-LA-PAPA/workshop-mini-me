# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Salidas del manual (se regeneran con: quarto render manual.qmd)
manual/_output/
manual/manual.typ
manual/manual.html
manual/manual_files/
manual/.quarto/

# Paquetes comprimidos (p. ej. la entrega original de datos): nunca se versionan
*.zip

# Salidas de las presentaciones (se regeneran con: quarto render presentacion/<archivo>.qmd)
presentacion/*.html
!presentacion/boceto.html
presentacion/*_files/
presentacion/.quarto/
