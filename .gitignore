# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Salidas de los PDF (se regeneran con: cd manual && quarto render)
manual/_output/
manual/guia_taller.typ
manual/agenda.typ
manual/reto_mini_me.typ
manual/manual.html
manual/manual_files/
manual/.quarto/

# Paquetes comprimidos (p. ej. la entrega original de datos): nunca se versionan
*.zip

# Salidas de las presentaciones (se regeneran con: quarto render presentacion/<archivo>.qmd)
presentacion/*.html
!presentacion/boceto.html
!presentacion/alianza.html
!presentacion/mini-mes.html
presentacion/*_files/
presentacion/.quarto/

# Archivos de sistema de macOS
.DS_Store

/.quarto/
**/*.quarto_ipynb
